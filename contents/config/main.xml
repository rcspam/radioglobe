<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <!-- Keep every entry in the single "General" group: Plasma stores them as
       [Configuration][General][key] and renaming the group loses user data. -->
  <group name="General">
    <entry name="favorites" type="String">
      <default>[]</default>
    </entry>
    <entry name="history" type="String">
      <default>[]</default>
    </entry>
    <entry name="lastStation" type="String">
      <default></default>
    </entry>
    <entry name="volume" type="Double">
      <default>0.75</default>
    </entry>
    <entry name="mpvPid" type="Int">
      <default>0</default>
    </entry>
    <entry name="mpvPath" type="String">
      <default></default>
    </entry>
    <entry name="maxWorldStations" type="Int">
      <default>3000</default>
    </entry>
    <!-- Located stations fetched on top of the popular ones when a country
         is opened (three times that for the largest countries) or a search
         is run. -->
    <entry name="maxCountryStations" type="Int">
      <default>500</default>
    </entry>
    <entry name="maxSearchStations" type="Int">
      <default>500</default>
    </entry>
    <!-- ISO 3166-1 alpha-2 code. Empty means "take it from the locale". -->
    <entry name="homeCountry" type="String">
      <default></default>
    </entry>
    <!-- Stations without coordinates get an approximate spot inside their
         country on the globe (home country then loaded whole). -->
    <entry name="approximateLocations" type="Bool">
      <default>false</default>
    </entry>
    <entry name="sendClicks" type="Bool">
      <default>true</default>
    </entry>
    <!-- Keeps the popup open when it loses focus ("keep open" button). -->
    <entry name="pinned" type="Bool">
      <default>false</default>
    </entry>
    <!-- Wheel up on the panel icon lowers the volume instead of raising it. -->
    <!-- Icon name from the theme for the panel / tray icon. -->
    <entry name="icon" type="String">
      <default>map-globe</default>
    </entry>
    <!-- Colours as "#rrggbb"; empty follows the theme (text colour for the
         icon, highlight colour for the playing badge). -->
    <entry name="iconColor" type="String">
      <default>#226ce7</default>
    </entry>
    <entry name="badgeColor" type="String">
      <default>#4fa710</default>
    </entry>
    <entry name="invertWheel" type="Bool">
      <default>false</default>
    </entry>
    <entry name="showDayNight" type="Bool">
      <default>true</default>
    </entry>
    <!-- At startup, the last station played is back in the player, ready
         (restoreLastStation), and starts on its own (autoplayLastStation). -->
    <entry name="restoreLastStation" type="Bool">
      <default>true</default>
    </entry>
    <entry name="autoplayLastStation" type="Bool">
      <default>false</default>
    </entry>
    <!-- What next / previous walk: "queue" (the list the station was played
         from) or "favorites". -->
    <entry name="nextPreviousSource" type="String">
      <default>queue</default>
    </entry>
    <!-- Not settings: the popup size libplasma saves on every close and reads
         first when the popup opens. Declared so main.qml can seed them at the
         first launch, when a widget dropped from the explorer otherwise opens
         its popup at an arbitrary small size. -->
    <entry name="popupWidth" type="Int">
      <default>0</default>
    </entry>
    <entry name="popupHeight" type="Int">
      <default>0</default>
    </entry>
    <!-- Not a setting: which page the next configuration dialog opens on
         ("addStation" or empty). Set by the popup's "+" button, cleared by
         the page itself once shown. -->
    <entry name="configStartPage" type="String">
      <default></default>
    </entry>
    <!-- Not a setting either: the station (JSON) the "Add a station" page
         should open prefilled with, consumed and cleared by the page. -->
    <entry name="editStation" type="String">
      <default></default>
    </entry>
  </group>
</kcfg>
